{
  "name": "smoke-or-fire-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "node scripts/build-data.mjs && node scripts/vendor-map.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild": "node scripts/build-data.mjs && node scripts/vendor-map.mjs",
    "preview": "vite preview",
    "deploy": "npm run tiles && npm run build && npx --yes vercel@60 deploy dist --prod --project smoke-or-fire --scope soufianes-projects-2f519552",
    "test": "vitest run",
    "e2e": "playwright test --project=flow --project=small-screens --project=map",
    "strings:todo": "node scripts/strings-todo.mjs",
    "strings:format": "node scripts/format-strings.mjs",
    "data:build": "node scripts/build-data.mjs",
    "tiles": "node scripts/fetch-tiles.mjs",
    "icons": "node scripts/build-icons.mjs",
    "e2e:pixels": "playwright test --project=pixels",
    "e2e:shots": "playwright test --project=screenshots",
    "e2e:perf": "playwright test --project=perf",
    "e2e:real": "playwright test -c playwright.real.config.ts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "maplibre-gl": "6.12.0",
    "pmtiles": "4.5.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^6.1.1",
    "ajv": "8.20.0",
    "htmlparser2": "^12.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "topojson-server": "^3.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
