# Secrets
.env
.env.*
# The web app's production engine URL is public, not a secret.
!web/.env.production

# Packed design bundles and PDF exports (design/screens/ is the source of truth)
design/*.html
*.pdf

# Live wind grid saved by the engine between restarts
.cache/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Web app
node_modules/
web/dist/
web/dist-e2e/
web/test-results/
web/screenshots/
web/playwright-report/
web/blob-report/
*.tsbuildinfo
.eslintcache
.vercel/

# Map: the basemap extract is fetched (npm run tiles), the pmtiles tool is kept in web/.cache/, and MapLibre's own
# modules are copied from node_modules
web/public/tiles/
web/public/vendor/

# OS
.DS_Store
Thumbs.db
